#! /bin/sh

set -eu

usage() {
  echo 'usage: rsyncp [-p prefix] [-s suffix] [-x flag] -- rsync_arg...' > /dev/stderr
}

prefix=
suffix=
excluded_cookie_flags=
while getopts 'hp:s:x:' opt; do
  case $opt in
    h) usage ; exit 0 ;;
    p) prefix=$OPTARG ;;
    s) suffix=$OPTARG ;;
    x) excluded_cookie_flags="$excluded_cookie_flags $OPTARG" ;;
    *) usage; exit 2 ;;
  esac
done

if [ "$OPTIND" -gt 2 ]; then
  shift "$((OPTIND - 2))"
fi

if [ "${1-}" = "--" ]; then
  shift
else
  usage
  exit 2
fi

if [ "$#" -eq 0 ]; then
  usage
  exit 2
fi

if [ ! -t 1 ]; then
  # If we're not running in a terminal, there's no point trying to be clever
  # with the progress bar, so execute rsync normally.
  exec rsync "$@"
fi

# Return 0 if `$1` is an arg to be excluded from the c
is_arg_excluded() {
  for flag in $excluded_cookie_flags; do
    case $1 in
      "$flag"|"$flag"=*) return 0 ;;
    esac
  done
  return 1
}

hash_cmd() {
  for x in sha256 sha256sum md5 md5sum; do
    if command -v "$x" > /dev/null 2>&1; then
      "$x"
      return 0
    fi
  done
  echo "No usable hash command found. Install one of: sha256, sha256sum, md5, md5sum" > /dev/stderr
  exit 1
}

cookie=$(
  for arg do
    if ! is_arg_excluded "$arg"; then
      printf '%s\n' "$arg"
    fi
  done | hash_cmd
)

state_home=${XDG_STATE_HOME:-"$HOME/.local/state"}
state_dir="$state_home/rsyncp"
state_file="$state_dir/$cookie"
mkdir -p "$state_dir"
cols=$(tput cols 2>/dev/null || printf 80)
status_file=$(mktemp)

cleanup() {
  rm -f "$status_file"
  tput cnorm 2> /dev/null || :

}

trap cleanup EXIT HUP INT TERM
tput civis 2> /dev/null || :

{
  set +e
  rsync --info=progress2 "$@"
  status="$?"
  set -e
  printf '%s\n' "$status" > "$status_file"
} | awk \
  -v cols="$cols" \
  -v prefix="$prefix" \
  -v suffix="$suffix" \
  -v state_file="$state_file" \
  '
  BEGIN {
    start_time = systime()
    last_sample_time = start_time
    if ((getline line < state_file) > 0) prior_total = line
    if ((getline line < state_file) > 0) prior_seconds = line
    close(state_file)
    if (prior_seconds > 0) ema_rate = prior_total / prior_seconds
    RS = "\r"
  }

  function term_print(left, right) {
    width = cols - length(left)
    if (width < 0) width = 0
    if (length(right) > width) {
      if (width > 3) right = "..." substr(right, length(right) - width + 4)
      else right = substr("...", 1, width)
    }
    printf "\r%s%*s\033[K", left, width, right
    fflush()
  }

  function update_eta(current_total, prior_total) {
    ts = systime()
    if (ts > last_sample_time) {
      sample_rate = (current_total - last_sample_total) / (ts - last_sample_time)
      if (ema_rate > 0) ema_rate = 0.2 * sample_rate + (1 - 0.2) * ema_rate
      else ema_rate = sample_rate
      last_sample_time = ts
      last_sample_total = current_total
    }

    if (current_total >= prior_total) return "00:00"
    else if (ema_rate > 0) {
      remaining = (prior_total - current_total) / ema_rate
      minutes = remaining / 60
      if (minutes >= 60) return sprintf("%02d:%02d:%02d", minutes / 60, minutes % 60, remaining % 60)
      else return sprintf("%02d:%02d", minutes, remaining % 60)
    }
    else return "??:??"
  }

  match($0, /(ir-chk|to-chk)=[0-9]+\/[0-9]+/) {
    s = substr($0, RSTART, RLENGTH)
    sub(/^(ir-chk|to-chk)=/, "", s)
    split(s, a, "/")
    current_total = a[2] + 0
    if (prior_total > 0) {
      if (current_total > prior_total) prior_total = current_total
      pct = int(100 * current_total / prior_total + 0.5)
      if (pct > 100) pct = 100
      eta_text = update_eta(current_total, prior_total)
      term_print(prefix, sprintf("ETA %s (%3d%%)%s", eta_text, pct, suffix))
    } else {
      term_print(prefix, sprintf("ETA ??:?? (%s files)%s", current_total, suffix))
    }
  }

  END {
    if (current_total > 0) {
      elapsed = systime() - start_time
      if (elapsed < 1) elapsed = 1
      print current_total > state_file
      print elapsed + 1 > state_file
    }
    printf ""
  }
'

exit "$(cat "$status_file" 2>/dev/null || printf 1)"
